+/* PTD driver version 1 soc-device records, transferred unchanged from ADT. */
+#define PMP_SOC_DEVICE_SIZE 0x7c
+#define PMP_SOC_DEVICE_FLAGS_OFFSET 8
+#define PMP_SOC_DEVICE_ACK BIT(1)
